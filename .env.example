APP_NAME=agyary
APP_ENV=development
APP_DEBUG=true

# Postgres
POSTGRES_USER=agyary
POSTGRES_PASSWORD=agyary
POSTGRES_DB=agyary
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full async DSN used by SQLAlchemy/asyncpg
DATABASE_URL=postgresql+asyncpg://agyary:agyary@db:5432/agyary

# WhatsApp Cloud API
# One token/app-secret/verify-token for the whole deployment - per-agyary
# routing uses Agyary.wa_phone_number_id (a DB column, not an env var).
WHATSAPP_API_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# WhatsApp Flows (Roj/Mah/Geh pickers, priest picker, services list).
# Private key stays here, PEM, unencrypted (same handling as
# WHATSAPP_APP_SECRET above); the matching public key is uploaded to Meta
# separately when each Flow is registered - a manual, one-off step outside
# this codebase, see src/agyary/messaging/wa_flows.py.
WHATSAPP_FLOWS_PRIVATE_KEY_PEM=
# Flow ids assigned by Meta on registration.
WHATSAPP_FLOW_ID_ROJ=
WHATSAPP_FLOW_ID_MAH=
WHATSAPP_FLOW_ID_GEH=
WHATSAPP_FLOW_ID_PRIEST_PICKER=
WHATSAPP_FLOW_ID_SERVICES_PICKER=

# Mobed PWA JWT signing key - generate a real random value (e.g.
# `openssl rand -hex 32`), never reuse the dev placeholder.
# REQUIRED: the app refuses to start if this is empty. A blank key doesn't
# disable auth, it signs every session token with the empty string - anyone
# could then mint a token for any user.
JWT_SECRET_KEY=

# The Meta phone_number_id that mobed sign-in OTPs are sent FROM. Distinct
# from the per-agyari numbers: someone signing in for the first time has no
# agyari yet, so there is no per-tenant number available to send from.
# Leave blank in local development - the code is logged instead of sent.
# In production (APP_DEBUG=false) an unset value makes the sign-in endpoint
# return 503 rather than silently accept codes nobody can receive.
WHATSAPP_OTP_PHONE_NUMBER_ID=

# The approved Authentication template the code is sent inside. WhatsApp
# rejects free-text business-initiated messages, so nothing can be delivered
# without this. LANGUAGE is the template's own code, not a display label:
# "en" and "en_US" are different templates to the API and a mismatch fails
# at send time. Set HAS_COPY_CODE=false for a template without a copy-code
# button - templates reject components they don't define.
#
# Keep OTP_TTL_SECONDS in step with the expiry the template's footer states:
# the template text is fixed at approval, so changing one alone makes the
# message tell users something untrue.
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
WHATSAPP_OTP_TEMPLATE_HAS_COPY_CODE=true

# Cloudflare Tunnel (docker-compose cloudflared service)
# Token for a tunnel already created in the Cloudflare dashboard - see
# https://one.dash.cloudflare.com -> Networks -> Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=
