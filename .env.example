APP_NAME=agyary
APP_ENV=development
APP_DEBUG=true

# Postgres
POSTGRES_USER=agyary
POSTGRES_PASSWORD=agyary
POSTGRES_DB=agyary
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full async DSN used by SQLAlchemy/asyncpg
DATABASE_URL=postgresql+asyncpg://agyary:agyary@db:5432/agyary

# --- WhatsApp -----------------------------------------------------------------
# This deployment RECEIVES from Meta and never sends to it, so there is no
# API token and no phone_number_id here. Sign-in works by the mobed
# messaging US a code (see src/agyary/services/wa_login.py), which is why it
# needs no approved template, no System User token and costs nothing per
# sign-in. Anything that sends would need all three back.
#
# A string you invent (e.g. `openssl rand -hex 16`). Paste the SAME value
# into Meta's webhook configuration - the GET handshake compares them.
WHATSAPP_VERIFY_TOKEN=
# The Meta App's own secret: App Settings -> Basic -> App Secret. The webhook
# verifies every payload's HMAC against this and returns 503 while it is
# blank, rather than comparing against b"" and accepting anything.
WHATSAPP_APP_SECRET=
# The dialable E.164 number the wa.me deep link points at. Must be on a real
# WhatsApp Business Account, and must have been registered on it - a number
# that is merely added and ownership-verified does not yet receive webhooks.
WHATSAPP_SIGNIN_NUMBER=
# How long a started sign-in stays claimable. Generous because this flow
# makes the user leave the browser for another app and come back.
WA_LOGIN_TTL_SECONDS=600
#
# Point the webhook at https://<your-host>/webhooks/whatsapp and subscribe it
# to the "messages" field. Nothing else needs subscribing.

# Mobed PWA JWT signing key - generate a real random value (e.g.
# `openssl rand -hex 32`), never reuse the dev placeholder.
# REQUIRED: the app refuses to start if this is empty. A blank key doesn't
# disable auth, it signs every session token with the empty string - anyone
# could then mint a token for any user.
JWT_SECRET_KEY=

# Cloudflare Tunnel (docker-compose cloudflared service)
# Token for a tunnel already created in the Cloudflare dashboard - see
# https://one.dash.cloudflare.com -> Networks -> Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=
