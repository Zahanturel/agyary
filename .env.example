APP_NAME=agyary
APP_ENV=development
APP_DEBUG=true

# Postgres
POSTGRES_USER=agyary
POSTGRES_PASSWORD=agyary
POSTGRES_DB=agyary
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full async DSN used by SQLAlchemy/asyncpg
DATABASE_URL=postgresql+asyncpg://agyary:agyary@db:5432/agyary

# --- WhatsApp -----------------------------------------------------------------
# This deployment RECEIVES from Meta and never sends to it, so there is no
# API token and no phone_number_id here. Sign-in works by the mobed
# messaging US a code (see src/agyary/services/wa_login.py), which is why it
# needs no approved template, no System User token and costs nothing per
# sign-in. Anything that sends would need all three back.
#
# A string you invent (e.g. `openssl rand -hex 16`). Paste the SAME value
# into Meta's webhook configuration - the GET handshake compares them.
WHATSAPP_VERIFY_TOKEN=
# The Meta App's own secret: App Settings -> Basic -> App Secret. The webhook
# verifies every payload's HMAC against this and returns 503 while it is
# blank, rather than comparing against b"" and accepting anything.
WHATSAPP_APP_SECRET=
# The dialable E.164 number the wa.me deep link points at. Must be on a real
# WhatsApp Business Account, and must have been registered on it - a number
# that is merely added and ownership-verified does not yet receive webhooks.
WHATSAPP_SIGNIN_NUMBER=
# How long a started sign-in stays claimable. Generous because this flow
# makes the user leave the browser for another app and come back.
WA_LOGIN_TTL_SECONDS=600
#
# Point the webhook at https://<your-host>/webhooks/whatsapp and subscribe it
# to the "messages" field. Nothing else needs subscribing.

# --- Memorial reminders (the one thing this app sends) ------------------------
# Sign-in above only receives. Reminders are business-initiated, so they need
# a System User access token, the number's phone_number_id and a template Meta
# has approved (the text is reminder_message.TEMPLATE_BODY). Never commit
# these; set them in .env on the server only.
#
# Business Settings -> Users -> System users -> generate a token with
# whatsapp_business_messaging for the WhatsApp account.
WHATSAPP_ACCESS_TOKEN=
# WhatsApp Manager -> Phone numbers -> the number -> Phone number ID.
WHATSAPP_PHONE_NUMBER_ID=
# The approved template's name and language.
WHATSAPP_REMINDER_TEMPLATE=memorial_reminder
WHATSAPP_TEMPLATE_LANGUAGE=en
#
# off      nothing is planned or sent (the default)
# dry_run  reminders are planned and LOGGED as they would be sent; nothing leaves
#          and nothing is written, so it can be run any number of times
# live     reminders are sent - but only to REMINDERS_ALLOWLIST
REMINDERS_SEND_MODE=off
# Comma separated E.164 numbers, e.g. +919800000000,+919800000001. "*" means
# everyone. Empty means nobody, so going live is two deliberate steps.
REMINDERS_ALLOWLIST=
# Tomorrow's reminders go out from this hour (IST) until the cutoff; whatever
# has not gone by then is given up on rather than sent late.
REMINDERS_SEND_HOUR=19
REMINDERS_CUTOFF_HOUR=21

# --- Spend limits and admins ---------------------------------------------------
# Every message is paid, so these are ceilings. A reminder over one is NOT sent,
# its mobed is told so they can send it by hand, and the admins are alerted.
# Counted per IST day (month for the monthly one), over reminders planned or sent.
REMINDERS_DAILY_CAP=150
REMINDERS_MONTHLY_CAP=2000
REMINDERS_PER_MOBED_DAILY_CAP=40
REMINDERS_PER_AGYARY_DAILY_CAP=100
# Used only for the cost estimate on the admin screen; Meta's bill is the real one.
REMINDERS_COST_PER_MESSAGE_INR=0.14
# This many failures in a row (a single bad number does not count) pause ALL
# sending until an admin resumes it. An account-level error from Meta pauses at once.
REMINDERS_BREAKER_FAILURES=5
# Comma separated E.164 numbers who see the Admin screen, can pause sending, and
# receive alerts. Empty means nobody is an admin (and alerts only reach the log).
ADMIN_PHONES=

# --- Sign-in by a code on WhatsApp ----------------------------------------------
# A second way to sign in: type your number, get a six digit code, and the app
# reads it from the clipboard. Off by default. It sends a paid message to a number
# the caller names, so it is limited hard, and it needs an approved WhatsApp
# AUTHENTICATION template (named below), which Meta only allows once the business
# is verified. The "send us a code" sign-in works without any of this.
OTP_MODE=off
OTP_TEMPLATE=login_code
OTP_TTL_SECONDS=300
OTP_DAILY_CAP=100
OTP_NEW_NUMBER_HOURLY_CAP=20

# Mobed PWA JWT signing key - generate a real random value (e.g.
# `openssl rand -hex 32`), never reuse the dev placeholder.
# REQUIRED: the app refuses to start if this is empty. A blank key doesn't
# disable auth, it signs every session token with the empty string - anyone
# could then mint a token for any user.
JWT_SECRET_KEY=

# Cloudflare Tunnel (docker-compose cloudflared service)
# Token for a tunnel already created in the Cloudflare dashboard - see
# https://one.dash.cloudflare.com -> Networks -> Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=
